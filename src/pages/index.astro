---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import About from '../components/sections/About.astro';
import Research from '../components/sections/Research.astro';
import Events from '../components/sections/Events.astro';
import Projects from '../components/sections/Projects.astro';
import Team from '../components/sections/Team.astro';
import ScrollPhrase from '../components/sections/ScrollPhrase.astro';
import JoinUs from '../components/sections/JoinUs.astro';
---

<BaseLayout
  title="IEEE CS & CIS UTB | Capítulo estudiantil UTB"
  description="Capítulo conjunto IEEE Computer Society & Computational Intelligence Society en la Universidad Tecnológica de Bolívar."
>
  <!-- 1. Hero: Declaración & Identidad IEEE CS + CIS UTB -->
  <Hero />

  <!-- 2. Sobre Nosotros: Misión, Visión, Objetivo & Miembros -->
  <AboutUs />

  <!-- 3. Manifiesto Interactivo: Sticky Media Stage -->
  <About />

  <!-- 4. Investigación: Constelación de Nodos Interactiva & Acordeón Móvil -->
  <Research />

  <!-- 5. Eventos: Timeline Cronológico Alternado con Progreso Animado -->
  <Events />

  <!-- 6. Proyectos: Showcase Case Study Destacado & Grid de Proyectos -->
  <Projects />

  <!-- 7. Equipo: Personas & Liderazgo con Overlays Interactivos -->
  <Team />

  <!-- 7.5. Frase Dinámica por Scroll (Tipografía Cinética) -->
  <ScrollPhrase />

  <!-- 8. Únete al Capítulo: 3 Pasos de Vinculación & CTA -->
  <JoinUs />
</BaseLayout>

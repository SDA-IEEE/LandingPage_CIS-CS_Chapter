---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WhatWeDo from '../components/sections/WhatWeDo.astro';
import About from '../components/sections/About.astro';
import Research from '../components/sections/Research.astro';
import Events from '../components/sections/Events.astro';
import Projects from '../components/sections/Projects.astro';
import Team from '../components/sections/Team.astro';
import JoinUs from '../components/sections/JoinUs.astro';
---

<BaseLayout
  title="IEEE CS & CIS UTB — Capítulo estudiantil de Computer Society & Computational Intelligence Society"
  description="Capítulo conjunto IEEE Computer Society & Computational Intelligence Society de la Universidad Tecnológica de Bolívar. Comité, líneas de trabajo, proyectos y eventos de la comunidad."
>
  <!-- 1. Hero: Declaración & Identidad IEEE CS + CIS UTB -->
  <Hero />

  <!-- 2. Qué Hacemos: 4 Áreas & Centro de Convergencia CS x CIS UTB -->
  <WhatWeDo />

  <!-- 3. Nosotros: Sticky Media Stage & Manifiesto Interactivo -->
  <About />

  <!-- 4. Investigación: Constelación de Nodos Interactiva & Acordeón Móvil -->
  <Research />

  <!-- 5. Eventos: Timeline Cronológico Alternado con Progreso Animado -->
  <Events />

  <!-- 6. Proyectos: Showcase Case Study Destacado & Grid de Proyectos -->
  <Projects />

  <!-- 7. Equipo: Personas & Liderazgo con Overlays Interactivos -->
  <Team />

  <!-- 8. Únete al Capítulo: 3 Pasos de Vinculación & CTA -->
  <JoinUs />
</BaseLayout>

---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { siteConfig } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Ruta absoluta o relativa a una imagen 1200x630 para Open Graph/Twitter. */
  image?: string;
}

const {
  title = "IEEE CS & CIS UTB | Capítulo estudiantil UTB",
  description = siteConfig.description,
  image = "/images/hero-community.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url);
const socialImageURL = new URL(image, Astro.site ?? siteConfig.url);

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollegiateProgram",
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  description: siteConfig.description,
  url: siteConfig.url,
  parentOrganization: {
    "@type": "CollegeOrUniversity",
    name: siteConfig.university,
  },
  sameAs: Object.values(siteConfig.socials).filter(
    (value): value is string =>
      typeof value === "string" && value.startsWith("http"),
  ),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logos/ieee-mb-blue.webp" />
    <link rel="icon" type="image/png" href="/logos/ieee-mb-blue.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Preload LCP Hero Image (Aceleración de carga Mobile & Desktop) -->
    <!-- Móvil: imagesrcset hace que el preload coincida con lo que el -->
    <!-- navegador elegirá del srcset (768w en DPR 1.75 tipo Moto G Power). -->
    <link
      rel="preload"
      as="image"
      imagesrcset="/images/hero-community-sm.webp 640w, /images/hero-community-md.webp 768w"
      imagesizes="100vw"
      href="/images/hero-community-md.webp"
      media="(max-width: 768px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero-community.webp"
      media="(min-width: 769px)"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
      is:inline
    />

    <!-- Google Fonts (Carga asíncrona no bloqueante recomendada por Web Vitals) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      />
    </noscript>
  </head>
  <body>
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Core Interactive Scripts -->
    <script is:inline>
      (function () {
        "use strict";
        const header = document.getElementById("header");
        const mobileMenu = document.getElementById("mobileMenu");
        const menuOverlay = document.getElementById("menuOverlay");
        const menuToggle = document.querySelector(".menu-toggle");

        window.toggleMenu = function () {
          if (!mobileMenu || !menuOverlay) return;
          const isOpen = mobileMenu.classList.contains("open");
          mobileMenu.classList.toggle("open");
          menuOverlay.classList.toggle("open");
          if (menuToggle)
            menuToggle.setAttribute("aria-expanded", String(!isOpen));
          document.body.style.overflow = !isOpen ? "hidden" : "";
        };

        window.toggleAccordion = function (headerEl) {
          const item = headerEl.parentElement;
          const isOpen = item.classList.contains("open");
          document
            .querySelectorAll(".research-accordion-item")
            .forEach((i) => i.classList.remove("open"));
          if (!isOpen) item.classList.add("open");
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!header) return;
            if (window.scrollY > 60) {
              header.classList.add("scrolled");
            } else {
              header.classList.remove("scrolled");
            }
          },
          { passive: true },
        );

        // Reveal Observer
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        document
          .querySelectorAll(".reveal")
          .forEach((el) => revealObserver.observe(el));

        // Timeline Progress
        const timelineItems = document.querySelectorAll(".timeline-item");
        const timelineProgress = document.getElementById("timelineProgress");
        const timelineObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
              }
            });
          },
          { threshold: 0.2 },
        );
        timelineItems.forEach((item) => timelineObserver.observe(item));

        let timelineTicking = false;
        function updateTimelineProgress() {
          const timeline = document.querySelector(".events-timeline");
          if (!timeline || !timelineProgress) return;
          const rect = timeline.getBoundingClientRect();
          const windowH = window.innerHeight;
          const start = rect.top;
          const end = rect.bottom - windowH;
          const total = rect.height - windowH;
          let progress = 0;
          if (start < windowH && end > 0) {
            progress = (windowH - start) / total;
          } else if (end <= 0) {
            progress = 1;
          }
          progress = Math.max(0, Math.min(1, progress));
          timelineProgress.style.height = progress * 100 + "%";
          timelineTicking = false;
        }
        window.addEventListener("scroll", () => {
          if (!timelineTicking) {
            window.requestAnimationFrame(updateTimelineProgress);
            timelineTicking = true;
          }
        }, {
          passive: true,
        });
        window.requestAnimationFrame(updateTimelineProgress);

        // Interactive Research Map
        const researchNodes = document.querySelectorAll(".research-node");
        const researchDetailTitle = document.getElementById(
          "researchDetailTitle",
        );
        const researchDetailDescription = document.getElementById(
          "researchDetailDescription",
        );
        researchNodes.forEach((node) => {
          node.addEventListener("click", () => {
            const title = node.getAttribute("data-line-title");
            const description = node.getAttribute("data-line-description");
            if (
              !title ||
              !description ||
              !researchDetailTitle ||
              !researchDetailDescription
            )
              return;
            researchNodes.forEach((item) => {
              item.classList.remove("active");
              item.setAttribute("aria-pressed", "false");
            });
            node.classList.add("active");
            node.setAttribute("aria-pressed", "true");
            researchDetailTitle.textContent = title;
            researchDetailDescription.textContent = description;
          });
        });

        // Hero Showcase Rotator (solo desktop ≥1025px; en móvil/tablet el
        // showcase está oculto con CSS, así que se evita precargar las
        // imágenes pesadas y el setInterval permanente).
        const heroShowcase = document.getElementById("heroShowcase");
        const showcaseDesktopMedia = window.matchMedia("(min-width: 1025px)");
        if (heroShowcase && showcaseDesktopMedia.matches) {
          const frontCard = heroShowcase.querySelector(
            "[data-hero-card='front']",
          );
          const backCard = heroShowcase.querySelector(
            "[data-hero-card='back']",
          );
          const dots = heroShowcase.querySelectorAll(".hero-dot");
          const slides = [
            {
              image: "/images/hero-community.webp",
              alt: "Estudiantes colaborando en proyecto tecnológico",
              kicker: "Próxima generación",
              title: "Tecnología con propósito",
            },
            {
              image: "/images/about-research.webp",
              alt: "Equipo trabajando en investigación",
              kicker: "Investigación aplicada",
              title: "IA para resolver desafíos reales",
            },
            {
              image: "/images/about-devs.webp",
              alt: "Desarrolladores construyendo soluciones colaborativas",
              kicker: "Construcción colaborativa",
              title: "Código que transforma ideas",
            },
          ];
          let currentIndex = 0;
          let transitioning = false;

          const deferPreload =
            window.requestIdleCallback || ((cb) => setTimeout(cb, 2000));
          deferPreload(() => {
            slides.forEach((slide) => {
              const im = new Image();
              im.src = slide.image;
            });
          });

          function setCardContent(card, slide) {
            if (!card) return;
            const img = card.querySelector("img");
            const kicker = card.querySelector(".hero-card-kicker");
            const title = card.querySelector("h3");
            if (img) {
              img.src = slide.image;
              img.alt = slide.alt;
            }
            if (kicker) kicker.textContent = slide.kicker;
            if (title) title.textContent = slide.title;
          }

          function renderShowcase() {
            const frontSlide = slides[currentIndex];
            const backSlide = slides[(currentIndex + 1) % slides.length];
            setCardContent(backCard, backSlide);
            dots.forEach((dot, index) => {
              dot.classList.toggle("is-active", index === currentIndex);
            });
            if (transitioning) return;
            transitioning = true;
            frontCard.classList.add("is-switching");
            setTimeout(() => {
              setCardContent(frontCard, frontSlide);
              window.requestAnimationFrame(() => {
                frontCard.classList.remove("is-switching");
              });
              transitioning = false;
            }, 480);
          }

          renderShowcase();
          window.setInterval(() => {
            currentIndex = (currentIndex + 1) % slides.length;
            renderShowcase();
          }, 5000);
        }

        // Hero Background Rotator (solo móvil/tablet ≤1024px): el fondo del
        // hero rota cinematográficamente por crossfade entre 3 fotos.
        // En desktop el showcase de tarjetas ya ofrece ese dinamismo.
        const heroBgSlides = document.querySelectorAll(".hero-bg-slide");
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        if (
          heroBgSlides.length >= 2 &&
          !showcaseDesktopMedia.matches &&
          !reducedMotion.matches
        ) {
          const slideSourcesWebp = [
            "/images/about-research-sm.webp",
            "/images/about-devs-sm.webp",
          ];
          const slideSourcesAvif = [
            "/images/about-research-sm.avif",
            "/images/about-devs-sm.avif",
          ];
          // Detección real de soporte AVIF (decodificación de imagen 2x2).
          // Canvas.toDataURL no sirve: prueba codificación, no decodificación.
          const supportsAvif = () =>
            new Promise((resolve) => {
              const t = new Image();
              t.onload = () => resolve(t.width > 0);
              t.onerror = () => resolve(false);
              t.src =
                "data:image/avif;base64,";
            });
          let slideSources = slideSourcesWebp;
          let bgIndex = 0;
          let bgTimer = null;
          let bgImagesLoaded = false;
          let heroVisible = false;

          function maybeStartBgRotation() {
            if (bgTimer || !bgImagesLoaded || !heroVisible) return;
            bgTimer = window.setInterval(() => {
              bgIndex = (bgIndex + 1) % (slideSources.length + 1);
              // El índice 0 muestra la imagen base (sin capa activa)
              heroBgSlides.forEach((img, i) => {
                img.classList.toggle("is-active", i === bgIndex - 1);
              });
            }, 5000);
          }

          function stopBgRotation() {
            if (bgTimer) {
              window.clearInterval(bgTimer);
              bgTimer = null;
            }
          }

          // Asignar src solo cuando el navegador está inactivo (fuera del LCP)
          const deferBgPreload =
            window.requestIdleCallback || ((cb) => setTimeout(cb, 2000));
          deferBgPreload(async () => {
            if (await supportsAvif()) slideSources = slideSourcesAvif;
            heroBgSlides.forEach((img, i) => {
              img.src = slideSources[i];
            });
            bgImagesLoaded = true;
            maybeStartBgRotation();
          });

          // Rotar solo cuando el hero está visible (ahorro de batería/CPU)
          const heroEl = document.getElementById("hero");
          if (heroEl) {
            const bgRotationObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  heroVisible = entry.isIntersecting;
                  if (entry.isIntersecting) maybeStartBgRotation();
                  else stopBgRotation();
                });
              },
              { threshold: 0.2 },
            );
            bgRotationObserver.observe(heroEl);
          }
        }

        // Rotating Highlighted Word (sección Únete): palabra desaparece
        // y aparece otra con blur + scale + shimmer mejorado
        const rotatingWord = document.getElementById("rotatingWord");
        if (rotatingWord && !reducedMotion.matches) {
          const words = ["en solitario", "sin rumbo", "sin guía", "a oscuras"];
          let wordIndex = 0;
          let wordTimer = null;

          function rotateWord() {
            // PHASE 1 — Leave: palabra sube con blur y escala
            rotatingWord.classList.add("is-leaving", "is-animating");

            window.setTimeout(() => {
              // PHASE 2 — Swap: cambiar texto y posicionar abajo
              wordIndex = (wordIndex + 1) % words.length;
              rotatingWord.textContent = words[wordIndex];
              rotatingWord.classList.remove("is-leaving");
              rotatingWord.classList.add("is-entering");

              // Force reflow para aplicar posición inicial
              void rotatingWord.offsetWidth;

              // PHASE 3 — Enter: animar a posición final con shimmer
              rotatingWord.classList.remove("is-entering");
              rotatingWord.classList.add("is-revealed");

              // Limpiar clases después de la animación
              window.setTimeout(() => {
                rotatingWord.classList.remove("is-revealed", "is-animating");
              }, 850);
            }, 500);
          }

          const wordObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !wordTimer) {
                  wordTimer = window.setInterval(rotateWord, 3200);
                } else if (!entry.isIntersecting && wordTimer) {
                  window.clearInterval(wordTimer);
                  wordTimer = null;
                }
              });
            },
            { threshold: 0.3 },
          );
          wordObserver.observe(rotatingWord);
        }

        // Active Nav Observer
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                navLinks.forEach((link) => {
                  link.classList.toggle(
                    "active",
                    link.getAttribute("href") === "#" + id,
                  );
                });
              }
            });
          },
          { threshold: 0.3 },
        );
        sections.forEach((s) => sectionObserver.observe(s));

        // Smooth Anchor Click
        document.querySelectorAll("a[href^='#']").forEach((anchor) => {
          anchor.addEventListener("click", function (e) {
            const href = this.getAttribute("href");
            if (href && href.startsWith("#")) {
              e.preventDefault();
              const target = document.querySelector(href);
              if (target) {
                target.scrollIntoView({ behavior: "smooth", block: "start" });
              }
            }
          });
        });

        // ESC to close mobile menu
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            mobileMenu &&
            mobileMenu.classList.contains("open")
          ) {
            window.toggleMenu();
          }
        });
      })();
    </script>
  </body>
</html>

---
<header class="header" id="header">
  <div class="container">
    <div class="header-inner">
      <div class="logo-group" aria-label="Logos oficiales">
        <a href="https://www.ieee.org/" target="_blank" rel="noopener noreferrer" aria-label="IEEE" title="IEEE">
          <img class="logo-image" src="/logos/ieee-mb-blue.png" alt="IEEE" />
        </a>
        <a href="https://www.computer.org/" target="_blank" rel="noopener noreferrer" aria-label="IEEE Computer Society" title="IEEE Computer Society">
          <img class="logo-image" src="/logos/ieee-cs-logo-orange.png" alt="IEEE Computer Society" />
        </a>
        <a href="https://cis.ieee.org/" target="_blank" rel="noopener noreferrer" aria-label="IEEE Computational Intelligence Society" title="IEEE Computational Intelligence Society">
          <img class="logo-image" src="/logos/ieee-cis-logo.png" alt="IEEE Computational Intelligence Society" />
        </a>
        <a href="https://www.utb.edu.co/" target="_blank" rel="noopener noreferrer" aria-label="Universidad Tecnológica de Bolívar" title="Universidad Tecnológica de Bolívar">
          <img class="logo-image" src="/logos/Logo_UTB_Horizontal_Blue.png" alt="Universidad Tecnológica de Bolívar" />
        </a>
      </div>
      <nav class="nav-desktop" aria-label="Navegación principal">
        <a href="#hero" class="nav-link active">Inicio</a>
        <a href="#about" class="nav-link">Nosotros</a>
        <a href="#research" class="nav-link">Investigación</a>
        <a href="#events" class="nav-link">Eventos</a>
        <a href="#projects" class="nav-link">Proyectos</a>
        <a href="#team" class="nav-link">Equipo</a>
        <a href="#join" class="nav-cta">Únete</a>
      </nav>
      <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" onclick="window.toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-overlay" id="menuOverlay" onclick="window.toggleMenu()"></div>

<nav class="mobile-menu" id="mobileMenu" aria-label="Menú móvil">
  <div class="mobile-menu-top">
    <button class="close-menu" onclick="window.toggleMenu()" aria-label="Cerrar menú">
      &times;
    </button>
  </div>
  <div class="mobile-menu-links">
    <a href="#hero" class="nav-link" onclick="window.toggleMenu()">Inicio</a>
    <a href="#about" class="nav-link" onclick="window.toggleMenu()">Nosotros</a>
    <a href="#research" class="nav-link" onclick="window.toggleMenu()">Investigación</a>
    <a href="#events" class="nav-link" onclick="window.toggleMenu()">Eventos</a>
    <a href="#projects" class="nav-link" onclick="window.toggleMenu()">Proyectos</a>
    <a href="#team" class="nav-link" onclick="window.toggleMenu()">Equipo</a>
  </div>
  <a href="#join" class="nav-cta" onclick="window.toggleMenu()">Únete al capítulo</a>
</nav>

---
import { getCollection } from 'astro:content';

const lines = (await getCollection('lines')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section section-surface" id="what">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Qué hacemos</div>
      <h2 class="section-title">Nuestras líneas. Un propósito.</h2>
      <p class="section-desc">
        Convergencia deliberada entre software, inteligencia computacional,
        investigación y comunidad. No actividades aisladas: un ecosistema.
      </p>
    </div>
    <div class="what-grid reveal reveal-delay-1">
      <div class="what-connector"></div>
      <div class="what-center">
        <div class="what-center-text">CS × CIS<br />UTB</div>
      </div>
      {lines.map((line) => (
        <div class="what-item">
          <div class="what-number" aria-hidden="true">{line.data.icon}</div>
          <h3 class="what-title">{line.data.title}</h3>
          <p class="what-desc">{line.data.tagline}</p>
        </div>
      ))}
    </div>
  </div>
</section>

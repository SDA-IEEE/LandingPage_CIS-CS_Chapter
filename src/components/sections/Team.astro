---
import { getCollection } from 'astro:content';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const delayClasses = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3', 'reveal-delay-4', 'reveal-delay-1'];
---

<section class="section section-dark" id="team">
  <div class="container">
    <div class="section-heading reveal">
      <span class="team-label">Comité directivo</span>
      <h2 class="section-title">Personas antes que organigrama</h2>
      <p class="section-desc">
        Quienes construyen la comunidad. Comité directivo del capítulo IEEE
        Computer Society &amp; Computational Intelligence Society UTB.
      </p>
    </div>

    <div class="team-grid">
      {members.map((member, index) => (
        <div class={`team-speaker-card reveal ${delayClasses[index % delayClasses.length]}`}>
          <div class="team-avatar-capsule">
            <div class="team-avatar-ambient"></div>
            <div class="team-spotlight" aria-hidden="true"></div>
            <img
              src={member.data.image}
              alt={`Foto de ${member.data.name}, ${member.data.role} del capítulo`}
              class="team-avatar-img"
              loading="lazy"
            />
          </div>

          <div class="team-speaker-info">
            <span class="team-speaker-role">{member.data.role}</span>
            <h3 class="team-speaker-name">{member.data.name}</h3>
            {member.data.focus.length > 0 && (
              <p class="team-speaker-desc">{member.data.focus.join(' · ')}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #team {
    position: relative;
    width: 100%;
    background: var(--dark, #0a1628);
    padding: 130px 0 140px;
    z-index: 10;
  }

  @media (min-width: 1024px) {
    #team {
      padding: 150px 0 170px;
    }
  }

  /* Etiqueta superior de la sección (texto plano, sin caja) */
  .team-label {
    display: inline-block;
    font-family: var(--font-display, "Montserrat", sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cis-cyan, #00a9e0);
    margin-bottom: 14px;
  }

  /* Grilla responsive de los 5 integrantes (2 por fila desde móvil) */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 520px) {
    .team-grid {
      gap: 24px;
    }
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
    }
  }

  /* Compactación en móvil (dos tarjetas por fila) */
  @media (max-width: 520px) {
    .team-avatar-capsule {
      border-radius: 20px;
    }

    .team-speaker-info {
      padding-top: 12px;
    }

    .team-speaker-role {
      font-size: 0.64rem;
      letter-spacing: 0.1em;
    }

    .team-speaker-name {
      font-size: 0.98rem;
    }

    .team-speaker-desc {
      font-size: 0.72rem;
    }

    #team {
      padding: 80px 0 90px;
    }
  }

  /* Tarjeta de cada integrante */
  .team-speaker-card {
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.45s var(--transition-smooth, cubic-bezier(0.25, 0.46, 0.45, 0.94));
  }

  .team-speaker-card:hover {
    transform: translateY(-8px);
  }

  /* Cápsula redondeada azul para el retrato (inspirada en la referencia) */
  .team-avatar-capsule {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.34;
    border-radius: 36px;
    overflow: hidden;
    background: linear-gradient(175deg, #00629b 0%, #004572 60%, #003052 100%);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 169, 224, 0.22);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    transition: box-shadow 0.45s var(--transition-smooth, cubic-bezier(0.25, 0.46, 0.45, 0.94)),
                border-color 0.45s var(--transition-smooth, cubic-bezier(0.25, 0.46, 0.45, 0.94));
  }

  .team-speaker-card:hover .team-avatar-capsule {
    box-shadow: 0 20px 48px rgba(0, 98, 155, 0.45), 0 0 0 1.5px rgba(0, 169, 224, 0.6);
  }

  /* Imagen dentro de la cápsula: sin filtros, a todo color natural y con máxima presencia */
  .team-avatar-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    transform: scale(1.25) translateY(2%);
    transform-origin: center 25%;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .team-speaker-card:hover .team-avatar-img {
    transform: scale(1.3) translateY(2%);
  }

  /* Halo lumínico sutil superior dentro de la cápsula (detrás del miembro) */
  .team-avatar-ambient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(circle at 50% 15%, rgba(0, 169, 224, 0.25) 0%, transparent 65%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .team-speaker-card:hover .team-avatar-ambient {
    opacity: 0.5;
  }

  /* Spotlight interactivo: brillo que sigue el cursor (se activa con hover) */
  .team-spotlight {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 50%),
      rgba(0, 169, 224, 0.34) 0%,
      rgba(121, 203, 245, 0.1) 45%,
      transparent 68%
    );
    mix-blend-mode: screen;
    transition: opacity 0.35s ease;
  }

  .team-speaker-card:hover .team-spotlight {
    opacity: 1;
  }

  /* Metadatos y tipografía debajo de la cápsula */
  .team-speaker-info {
    padding-top: 18px;
    display: flex;
    flex-direction: column;
  }

  .team-speaker-role {
    font-family: var(--font-display, "Montserrat", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cis-cyan, #00a9e0);
    margin-bottom: 6px;
  }

  .team-speaker-name {
    font-family: var(--font-display, "Montserrat", sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--white, #ffffff);
    line-height: 1.25;
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
  }

  .team-speaker-desc {
    font-family: var(--font-body, "Open Sans", sans-serif);
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
    margin: 0;
  }
</style>

<script>
  function setupTeamSpotlights() {
    const cards = document.querySelectorAll<HTMLElement>('.team-speaker-card');
    cards.forEach((card) => {
      const capsule = card.querySelector<HTMLElement>('.team-avatar-capsule');
      const spot = card.querySelector<HTMLElement>('.team-spotlight');
      if (!capsule || !spot) return;

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = capsule.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        spot.style.setProperty('--mx', `${x}%`);
        spot.style.setProperty('--my', `${y}%`);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTeamSpotlights);
  } else {
    setupTeamSpotlights();
  }
  document.addEventListener('astro:page-load', setupTeamSpotlights);
</script>

---
import { getCollection } from 'astro:content';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const [featuredMember, ...restMembers] = members;
const delayClasses = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3'];
---
<section class="section section-dark" id="team">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Comité</div>
      <h2 class="section-title">Personas antes que organigrama</h2>
      <p class="section-desc">
        Quienes construyen la comunidad. Comité directivo del capítulo IEEE
        Computer Society &amp; Computational Intelligence Society UTB.
      </p>
    </div>
    <div class="team-grid">
      {featuredMember && (
        <div class="team-card featured-member reveal">
          <div class="team-card-media">
            <img
              src={featuredMember.data.image}
              alt={`Foto de ${featuredMember.data.name}, ${featuredMember.data.role} del capítulo`}
              loading="lazy"
            />
            <div class="team-card-overlay">
              <div class="team-card-name">{featuredMember.data.name}</div>
              <div class="team-card-role">{featuredMember.data.role}</div>
              {featuredMember.data.focus.length > 0 && (
                <div class="team-card-focus">{featuredMember.data.focus.join(' · ')}</div>
              )}
            </div>
          </div>
          <div class="team-card-info">
            <div class="team-card-name-static">{featuredMember.data.name}</div>
            <div class="team-card-role-static">{featuredMember.data.role}</div>
          </div>
        </div>
      )}

      {restMembers.map((member, index) => (
        <div class={`team-card reveal ${delayClasses[index % delayClasses.length]}`}>
          <div class="team-card-media">
            <img
              src={member.data.image}
              alt={`Foto de ${member.data.name}, ${member.data.role} del capítulo`}
              loading="lazy"
            />
            <div class="team-card-overlay">
              <div class="team-card-name">{member.data.name}</div>
              <div class="team-card-role">{member.data.role}</div>
              {member.data.focus.length > 0 && (
                <div class="team-card-focus">{member.data.focus.join(' · ')}</div>
              )}
            </div>
          </div>
          <div class="team-card-info">
            <div class="team-card-name-static">{member.data.name}</div>
            <div class="team-card-role-static">{member.data.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
---
<section class="section section-dark" id="team">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Equipo</div>
      <h2 class="section-title">Personas antes que organigrama</h2>
      <p class="section-desc">
        Quienes construyen la comunidad. Liderazgo, miembros activos y asesores
        que hacen posible cada proyecto.
      </p>
    </div>
    <div class="team-grid">
      <div class="team-card featured-member reveal">
        <div class="team-card-media">
          <img
            src="/images/member-1.jpg"
            alt="Líder del capítulo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Carlos Mendoza</div>
            <div class="team-card-role">Presidente del Capítulo</div>
            <div class="team-card-focus">
              Liderazgo estratégico, visión técnica y representación
              institucional ante IEEE y UTB.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Carlos Mendoza</div>
          <div class="team-card-role-static">Presidente del Capítulo</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-1">
        <div class="team-card-media">
          <img
            src="/images/member-2.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Laura Vargas</div>
            <div class="team-card-role">Vicepresidenta CS</div>
            <div class="team-card-focus">
              Software architecture, sistemas distribuidos y mentoría técnica.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Laura Vargas</div>
          <div class="team-card-role-static">Vicepresidenta CS</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-2">
        <div class="team-card-media">
          <img
            src="/images/member-3.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Andrés Pérez</div>
            <div class="team-card-role">Vicepresidente CIS</div>
            <div class="team-card-focus">
              Machine learning, computer vision y líneas de investigación activas.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Andrés Pérez</div>
          <div class="team-card-role-static">Vicepresidente CIS</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-1">
        <div class="team-card-media">
          <img
            src="/images/member-4.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Mariana Torres</div>
            <div class="team-card-role">Directora de Proyectos</div>
            <div class="team-card-focus">
              Gestión de proyectos, metodologías ágiles y seguimiento de entregables.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Mariana Torres</div>
          <div class="team-card-role-static">Directora de Proyectos</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-2">
        <div class="team-card-media">
          <img
            src="/images/member-2.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Diego Herrera</div>
            <div class="team-card-role">Lead de Investigación</div>
            <div class="team-card-focus">
              Publicaciones, revisión de papers y conexión con grupos de investigación UTB.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Diego Herrera</div>
          <div class="team-card-role-static">Lead de Investigación</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-3">
        <div class="team-card-media">
          <img
            src="/images/member-1.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Sofía Castillo</div>
            <div class="team-card-role">Directora de Eventos</div>
            <div class="team-card-focus">
              Logística de talleres, hackathons y relaciones con comunidades tecnológicas.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Sofía Castillo</div>
          <div class="team-card-role-static">Directora de Eventos</div>
        </div>
      </div>

      <div class="team-card reveal reveal-delay-3">
        <div class="team-card-media">
          <img
            src="/images/member-4.jpg"
            alt="Miembro del equipo"
            loading="lazy"
          />
          <div class="team-card-overlay">
            <div class="team-card-name">Juan Ríos</div>
            <div class="team-card-role">Lead de Desarrollo</div>
            <div class="team-card-focus">
              Arquitectura de software, code reviews y estándares de calidad del capítulo.
            </div>
          </div>
        </div>
        <div class="team-card-info">
          <div class="team-card-name-static">Juan Ríos</div>
          <div class="team-card-role-static">Lead de Desarrollo</div>
        </div>
      </div>
    </div>
  </div>
</section>

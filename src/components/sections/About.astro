<section class="about-scroll" id="manifiesto">
  <div class="about-sticky">
    <!-- Fondo cinematográfico interactivo -->
    <div class="about-bg-container">
      <img
        src="/images/about-students.jpg"
        alt="Estudiantes trabajando colaborativamente en el laboratorio de tecnología"
        class="about-bg-image"
        loading="eager"
      />
      <div class="about-overlay"></div>
    </div>

    <!-- Escenario central de textos sincronizados por scroll -->
    <div class="about-text-stage">
      <!-- Mensaje 1 -->
      <div class="about-scroll-message" data-step="1">
        <h2>
          <span class="highlight">Somos estudiantes.</span>
        </h2>
        <div class="subtitle">
          Con curiosidad insaciable y disciplina de ingenieros.
        </div>
      </div>

      <!-- Mensaje 2 (El de la captura) -->
      <div class="about-scroll-message" data-step="2">
        <h2>
          <span class="highlight">Somos desarrolladores.</span>
        </h2>
        <div class="subtitle">
          Que escriben código que resuelve problemas reales.
        </div>
      </div>

      <!-- Mensaje 3 -->
      <div class="about-scroll-message" data-step="3">
        <h2>
          <span class="highlight">Somos investigadores.</span>
        </h2>
        <div class="subtitle">
          Que cuestionan, experimentan y publican resultados.
        </div>
      </div>

      <!-- Mensaje 4 -->
      <div class="about-scroll-message" data-step="4">
        <h2>
          <span class="highlight">Somos una comunidad.</span>
        </h2>
        <div class="subtitle">
          Donde el conocimiento se comparte sin jerarquías artificiales.
        </div>
      </div>

      <!-- Mensaje 5 (Clímax de identidad) -->
      <div class="about-scroll-message" data-step="5">
        <span class="about-final-badge">Capítulo Conjunto</span>
        <h2 class="about-final-title">
          Somos <span class="ieee-accent">IEEE</span>
          <span class="cs-accent">CS</span> & <span class="cis-accent">CIS</span
          > UTB
        </h2>
        <div class="subtitle">
          Construyendo inteligencia. Construyendo tecnología.
        </div>
      </div>
    </div>

    <!-- Indicador de desplazamiento inferior -->
    <div class="about-scroll-hint" id="aboutScrollHint">
      <span>Scroll</span>
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  function initAboutScrollPin() {
    const aboutSection = document.getElementById("manifiesto");
    if (!aboutSection) return;

    const messages = gsap.utils.toArray<HTMLElement>(".about-scroll-message");
    const bgImg = document.querySelector<HTMLElement>(".about-bg-image");
    const scrollHint = document.getElementById("aboutScrollHint");
    if (messages.length === 0) return;

    const totalSteps = messages.length;
    const stepHeight = () => window.innerHeight; // "1 scroll" = 1 viewport
    let currentStep = 0;
    let isAnimating = false;
    let sectionStartY = 0;

    // Estado inicial: primer mensaje visible, resto oculto
    gsap.set(messages[0], { opacity: 1, filter: "blur(0px)", scale: 1 });
    gsap.set(messages.slice(1), { opacity: 0, filter: "blur(18px)", scale: 1.05 });
    gsap.set(bgImg, { scale: 1 });

    // Pin de la sección. La distancia total = un "viewport" por cada paso.
    const st = ScrollTrigger.create({
      trigger: aboutSection,
      start: "top top",
      end: () => "+=" + stepHeight() * totalSteps,
      pin: true,
      anticipatePin: 1,
      onEnter: () => { sectionStartY = st.start; },
      onEnterBack: () => { sectionStartY = st.start; },
    });

    // --- Animación COMPLETA de un paso (no scrubbed) ---
    function playStep(nextStep: number, direction: 1 | -1) {
      if (isAnimating || nextStep < 0 || nextStep > totalSteps - 1) return;
      isAnimating = true;

      const current = messages[currentStep];
      const next = messages[nextStep];

      const tl = gsap.timeline({
        onComplete: () => {
          currentStep = nextStep;
          isAnimating = false;
        },
      });

      // Salida del mensaje actual
      tl.to(current, {
        opacity: 0,
        filter: "blur(18px)",
        scale: direction === 1 ? 1.05 : 0.95,
        duration: 0.5,
        ease: "power2.in",
      })
        // Entrada del siguiente mensaje
        .fromTo(
          next,
          { opacity: 0, filter: "blur(18px)", scale: direction === 1 ? 0.95 : 1.05 },
          { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" },
          "-=0.1"
        )
        // Zoom del fondo correspondiente a este paso (progresivo, todo el recorrido = 1.14)
        .to(
          bgImg,
          { scale: 1 + (0.14 * (nextStep + 1)) / totalSteps, ease: "none", duration: 0.9 },
          0
        );

      // Ocultar la pista de scroll en cuanto arranca el primer paso
      if (scrollHint && nextStep === 1) {
        gsap.to(scrollHint, { opacity: 0, y: 15, duration: 0.4 });
      }

      // Sincronizar la posición real de scroll con el paso (para que el pin avance/retroceda)
      gsap.to(window, {
        scrollTo: { y: sectionStartY + stepHeight() * nextStep },
        duration: 0.9,
        ease: "power2.inOut",
      });
    }

    // --- Interceptar el scroll nativo mientras estamos dentro de la sección pineada ---
    function isInsideSection() {
      return st.isActive;
    }

    function handleWheel(e: WheelEvent) {
      if (!isInsideSection()) return;

      const goingDown = e.deltaY > 0;

      // Si estamos en el último paso y se sigue bajando, dejamos pasar el scroll
      // (se libera el pin y continúa hacia la siguiente sección normalmente)
      if (goingDown && currentStep === totalSteps - 1) return;
      // Si estamos en el primer paso y se sigue subiendo, dejamos pasar el scroll
      if (!goingDown && currentStep === 0) return;

      e.preventDefault();
      if (isAnimating) return;

      if (goingDown) playStep(currentStep + 1, 1);
      else playStep(currentStep - 1, -1);
    }

    // Soporte táctil (swipe)
    let touchStartY = 0;
    function handleTouchStart(e: TouchEvent) {
      touchStartY = e.touches[0].clientY;
    }
    function handleTouchMove(e: TouchEvent) {
      if (!isInsideSection()) return;
      const deltaY = touchStartY - e.touches[0].clientY;
      const goingDown = deltaY > 0;

      if (goingDown && currentStep === totalSteps - 1) return;
      if (!goingDown && currentStep === 0) return;

      e.preventDefault();
      if (isAnimating || Math.abs(deltaY) < 30) return;

      touchStartY = e.touches[0].clientY;
      if (goingDown) playStep(currentStep + 1, 1);
      else playStep(currentStep - 1, -1);
    }

    window.addEventListener("wheel", handleWheel, { passive: false });
    window.addEventListener("touchstart", handleTouchStart, { passive: true });
    window.addEventListener("touchmove", handleTouchMove, { passive: false });

    // Limpieza al navegar (Astro SPA)
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("wheel", handleWheel);
        window.removeEventListener("touchstart", handleTouchStart);
        window.removeEventListener("touchmove", handleTouchMove);
        st.kill();
      },
      { once: true }
    );
  }

  initAboutScrollPin();
  document.addEventListener("astro:page-load", initAboutScrollPin);
</script>
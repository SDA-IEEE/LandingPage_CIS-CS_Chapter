<section class="about-scroll" id="manifiesto">
  <div class="about-sticky">
    <!-- Fondo cinematográfico interactivo -->
    <div class="about-bg-container">
      <img
        src="/images/about_student.png"
        alt="Estudiantes trabajando colaborativamente en el laboratorio de tecnología"
        class="about-bg-image"
        loading="eager"
      />
      <div class="about-overlay"></div>
    </div>

    <!-- Escenario central de textos sincronizados por scroll -->
    <div class="about-text-stage">
      <!-- Mensaje 1 -->
      <div class="about-scroll-message" data-step="1">
        <h2>
          <span class="highlight">Somos estudiantes.</span>
        </h2>
        <div class="subtitle">
          Con curiosidad insaciable y disciplina de ingenieros.
        </div>
      </div>

      <!-- Mensaje 2 (El de la captura) -->
      <div class="about-scroll-message" data-step="2">
        <h2>
          <span class="highlight">Somos desarrolladores.</span>
        </h2>
        <div class="subtitle">
          Que escriben código que resuelve problemas reales.
        </div>
      </div>

      <!-- Mensaje 3 -->
      <div class="about-scroll-message" data-step="3">
        <h2>
          <span class="highlight">Somos investigadores.</span>
        </h2>
        <div class="subtitle">
          Que cuestionan, experimentan y publican resultados.
        </div>
      </div>

      <!-- Mensaje 4 -->
      <div class="about-scroll-message" data-step="4">
        <h2>
          <span class="highlight">Somos una comunidad.</span>
        </h2>
        <div class="subtitle">
          Donde el conocimiento se comparte sin jerarquías artificiales.
        </div>
      </div>

      <!-- Mensaje 5 (Clímax de identidad) -->
      <div class="about-scroll-message" data-step="5">
        <span class="about-final-badge">Capítulo Conjunto</span>
        <h2 class="about-final-title">
          Somos <span class="ieee-accent">IEEE</span>
          <span class="cs-accent">CS</span> & <span class="cis-accent">CIS</span
          > UTB
        </h2>
        <div class="subtitle">
          Construyendo inteligencia. Construyendo tecnología.
        </div>
      </div>
    </div>

    <!-- Indicador de desplazamiento inferior -->
    <div class="about-scroll-hint" id="aboutScrollHint">
      <span>Scroll</span>
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAboutScrollPin() {
    const aboutSection = document.getElementById("manifiesto");
    if (!aboutSection) return;

    const messages = gsap.utils.toArray<HTMLElement>(".about-scroll-message");
    const bgImg = document.querySelector<HTMLElement>(".about-bg-image");
    const scrollHint = document.getElementById("aboutScrollHint");
    const header = document.getElementById("header");

    if (messages.length === 0) return;

    // 1. Desvanecer la pista de scroll al iniciar el avance
    if (scrollHint) {
      gsap.to(scrollHint, {
        opacity: 0,
        y: 15,
        scrollTrigger: {
          trigger: aboutSection,
          start: "top top",
          end: "+=150",
          scrub: true,
        },
      });
    }

    // 2. Línea de tiempo fijada (Pinned Timeline)
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: aboutSection,
        start: "top top",
        end: "+=2600", // Distancia total de scroll
        pin: true,
        scrub: 0.4,
        anticipatePin: 1,
        onToggle: (self) => {
          if (header) {
            header.classList.toggle("header-hidden", self.isActive);
          }
        },
        onEnter: () => header?.classList.add("header-hidden"),
        onLeave: () => header?.classList.remove("header-hidden"),
        onEnterBack: () => header?.classList.add("header-hidden"),
        onLeaveBack: () => header?.classList.remove("header-hidden"),
      },
    });

    // 3. El primer mensaje ya arranca visible en pantalla
    gsap.set(messages[0], { opacity: 1, filter: "blur(0px)", scale: 1 });

    // 4. Encadenar cada mensaje desde el segundo 0
    messages.forEach((msg, index) => {
      const isFirst = index === 0;
      const isLast = index === messages.length - 1;

      if (isFirst) {
        // PRIMER MENSAJE:
        // Pausa inicial para lectura al empezar a scrollear
        tl.to(msg, { duration: 1.0 })
          // Desvanecimiento hacia el segundo mensaje
          .to(msg, {
            opacity: 0,
            filter: "blur(18px)",
            scale: 1.05,
            duration: 0.8,
            ease: "power2.in",
          });
      } else {
        // MENSAJES SIGUIENTES:
        // Entrada (Fade in + Desenfoque a 0)
        tl.to(msg, {
          opacity: 1,
          filter: "blur(0px)",
          scale: 1,
          duration: 0.8,
          ease: "power2.out",
        })
          // Pausa de lectura
          .to(msg, {
            duration: 1.0,
          })
          // Salida (Fade out + Desenfoque)
          .to(msg, {
            opacity: 0,
            filter: isLast ? "blur(14px)" : "blur(18px)",
            scale: isLast ? 1.03 : 1.05,
            duration: 0.8,
            ease: "power2.in",
          });
      }
    });

    // 5. ZOOM DEL FONDO: Se añade AQUÍ al final
    // Al usar tl.duration() y el parámetro '0', abarca exactamente desde el inicio hasta el final de la timeline
    if (bgImg) {
      tl.to(
        bgImg,
        {
          scale: 1.14,
          ease: "none",
          duration: tl.duration(),
        },
        0, // Inicia en t = 0 en paralelo con los textos
      );
    }

    // Pequeño margen de gracia antes de soltar la sección hacia "Mapa de exploración"
    tl.to({}, { duration: 0.3 });
  }

  // Inicializar en carga y soportar navegación SPA/Astro
  initAboutScrollPin();
  document.addEventListener("astro:page-load", initAboutScrollPin);
</script>

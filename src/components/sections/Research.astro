---
import { getCollection } from 'astro:content';

const lines = (await getCollection('lines')).sort((a, b) => a.data.order - b.data.order);
const positions = [
  { x: '10%', y: '62%', tone: 'var(--ieee-blue)' },
  { x: '30%', y: '30%', tone: 'var(--cs-orange)' },
  { x: '50%', y: '55%', tone: 'var(--cis-cyan)' },
  { x: '70%', y: '25%', tone: '#5c8dff' },
  { x: '88%', y: '58%', tone: 'var(--ieee-blue)' },
];
const first = lines[0];
---
<section class="section section-surface" id="research">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Investigación</div>
      <h2 class="section-title">Mapa de exploración</h2>
      <p class="section-desc">
        Líneas de trabajo activas que conectan teoría con aplicación. Cada
        nodo representa un área donde el capítulo investiga y construye.
      </p>
    </div>

    <div class="research-map reveal reveal-delay-1">
      <div class="research-map-board">
        <div class="research-track-label">Ruta de exploración</div>
        <svg class="research-path" viewBox="0 0 900 520" preserveAspectRatio="none" aria-hidden="true">
          <path d="M70 370 C220 250, 350 245, 470 300 C590 355, 700 295, 830 155"></path>
        </svg>

        {lines.map((line, index) => {
          const pos = positions[index % positions.length];
          return (
            <button
              type="button"
              class={`research-node${index === 0 ? ' active' : ''}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-line-title={line.data.title}
              data-line-description={line.data.tagline}
              style={`--x: ${pos.x}; --y: ${pos.y}; --tone: ${pos.tone};`}
            >
              <span class="research-node-step">{String(index + 1).padStart(2, '0')}</span>
              <span class="research-node-label">{line.data.icon} {line.data.title}</span>
            </button>
          );
        })}
      </div>

      <aside class="research-detail-card">
        <div class="research-detail-header">
          <span class="research-detail-label">Línea</span>
          <span class="research-detail-status">Seleccionada</span>
        </div>
        <h3 id="researchDetailTitle">{first?.data.title}</h3>
        <p id="researchDetailDescription">{first?.data.tagline}</p>
        <a href="#projects" class="research-detail-link">
          Ver proyectos
          <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>

    <div class="research-mobile reveal">
      {lines.map((line, index) => (
        <div class={`research-accordion-item${index === 0 ? ' open' : ''}`}>
          <div class="research-accordion-header" onclick="window.toggleAccordion(this)">
            <span class="research-accordion-title">{line.data.icon} {line.data.title}</span>
            <svg class="research-accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </div>
          <div class="research-accordion-body">
            <p>{line.data.tagline}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

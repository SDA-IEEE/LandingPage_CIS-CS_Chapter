---
import { getCollection } from 'astro:content';

// Contenido dinámico: src/content/lines/*.md — NUNCA hardcodear líneas aquí.
const collapsedTitles: Record<string, string> = {
  'AI & Agentes': 'AI & Agentes',
  'Automatización Industrial': 'Automatización',
  'Visión Artificial': 'Visión Artificial',
  'Data Science': 'Data Science',
  'Desarrollo de Software': 'Software',
};

const lines = (await getCollection('lines'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry, index) => ({
    num: String(index + 1).padStart(2, '0'),
    collapsedTitle: collapsedTitles[entry.data.title] ?? entry.data.title,
    badge: `Línea ${String(index + 1).padStart(2, '0')}`,
    title: entry.data.title,
    desc: entry.data.tagline,
    image: entry.data.image,
    imageSm: entry.data.image ? entry.data.image.replace('.webp', '-sm.webp') : entry.data.image,
    active: index === 0,
  }));
---

<section class="research-section-wrapper" id="research" aria-label="Líneas de investigación">
  <div class="research-section">
    <div class="header-area">
      <span class="badge">Investigación</span>
      <h2 class="section-title">Nuestras líneas activas</h2>
      <p class="section-subtitle">Explora cada área tocando sobre ella para conocer nuestro enfoque de trabajo.</p>
    </div>

    <!-- CONTENEDOR DE TARJETAS EXPANDIBLES -->
    <div class="accordion-container" id="research-accordion">
      {lines.map((item) => (
        <div
          class={`accordion-item ${item.active ? 'active' : ''}`}
          role="button"
          tabindex="0"
          aria-expanded={item.active ? "true" : "false"}
          aria-label={item.title}
        >
          <img
            src={item.image}
            srcset={`${item.imageSm} 500w, ${item.image} 750w`}
            sizes="(max-width: 860px) 100vw, 750px"
            alt={item.title}
            class="item-bg"
            loading="lazy"
            decoding="async"
          />
          <div class="item-overlay"></div>

          <div class="collapsed-content">
            <span class="collapsed-num">{item.num}</span>
            <span class="collapsed-title">{item.collapsedTitle}</span>
            <div class="collapsed-indicator"></div>
          </div>

          <div class="expanded-content">
            <div class="expanded-badge">{item.badge}</div>
            <h3 class="expanded-title">{item.title}</h3>
            <p class="expanded-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .research-section-wrapper {
    background-color: #f8fafc;
    width: 100%;
    position: relative;
    scroll-margin-top: 70px;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }

  .research-section {
    --bg-section: #f8fafc;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --accent-blue: #0284c7;
    --accent-light: #e0f2fe;

    /* Curva fluida ultra suave */
    --smooth-ease: cubic-bezier(0.22, 1, 0.36, 1);

    max-width: 1360px;
    margin: 0 auto;
    padding: 90px 24px;
    font-family: 'Plus Jakarta Sans', var(--font-display, sans-serif);
    line-height: 1.5;
  }

  /* HEADER */
  .header-area {
    margin-bottom: 40px;
    max-width: 640px;
  }

  .badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-blue);
    margin-bottom: 10px;
  }

  .section-title {
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  /* ========================================================
     DESKTOP ( > 860px ): ACORDEÓN HORIZONTAL CON BLOOM
     ======================================================== */
  @media (min-width: 861px) {
    .accordion-container {
      display: flex;
      align-items: center;
      gap: 16px;
      height: 580px;
      width: 100%;
    }

    .accordion-item {
      position: relative;
      flex: 0.65;
      height: 74%;
      border-radius: 999px;
      overflow: hidden;
      cursor: pointer;
      box-shadow: 0 10px 28px -8px rgba(15, 23, 42, 0.08);
      user-select: none;
      transition: flex 0.95s var(--smooth-ease),
                  height 0.95s var(--smooth-ease),
                  border-radius 0.95s var(--smooth-ease),
                  box-shadow 0.6s ease;
    }

    .accordion-item.active {
      flex: 4.8;
      height: 100%;
      border-radius: 28px;
      cursor: default;
      box-shadow: 0 18px 42px -10px rgba(15, 23, 42, 0.16);
    }

    .accordion-item.active::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at center, rgba(255, 255, 255, 0.4) 0%, rgba(2, 132, 199, 0.18) 42%, transparent 75%);
      opacity: 0;
      animation: circleBloom 1.25s var(--smooth-ease) forwards;
      pointer-events: none;
      z-index: 2;
    }

    .collapsed-content {
      position: absolute;
      inset: 0;
      padding: 30px 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      z-index: 3;
      transition: opacity 0.35s ease;
    }

    .collapsed-title {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
      white-space: nowrap;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .expanded-content {
      position: absolute;
      inset: 0;
      padding: 48px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      z-index: 3;
      opacity: 0;
      pointer-events: none;
      transform: translateY(18px);
      transition: opacity 0.65s var(--smooth-ease) 0.24s, 
                  transform 0.65s var(--smooth-ease) 0.24s;
    }
  }

  @keyframes circleBloom {
    0% { transform: scale(0.2); opacity: 0.95; }
    60% { opacity: 0.5; }
    100% { transform: scale(1.65); opacity: 0; }
  }

  /* ========================================================
     MÓVIL / TABLET ( <= 860px ): TRANSICIÓN VERTICAL FLUIDA
     ======================================================== */
  @media (max-width: 860px) {
    .research-section {
      padding: 60px 18px;
    }

    .accordion-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }

    /* Alturas numéricas estrictas que el navegador interpola a 60fps */
    .accordion-item {
      position: relative;
      width: 100%;
      height: 68px; /* Altura de cápsula colapsada */
      border-radius: 20px;
      overflow: hidden;
      cursor: pointer;
      box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.08);
      user-select: none;
      transition: height 0.75s var(--smooth-ease),
                  border-radius 0.75s var(--smooth-ease),
                  box-shadow 0.4s ease;
    }

    .accordion-item.active {
      height: 400px; /* Altura desplegada estable */
      border-radius: 26px;
      box-shadow: 0 14px 34px -8px rgba(15, 23, 42, 0.18);
      cursor: default;
    }

    /* En táctil no debe escalarse la imagen al tocar */
    .accordion-item:hover .item-bg {
      transform: none;
    }

    .item-bg {
      object-position: center 28%;
    }

    /* Barra de la cápsula colapsada */
    .collapsed-content {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 68px;
      padding: 0 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 3;
      transition: opacity 0.25s ease;
    }

    .collapsed-title {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.08rem;
      font-weight: 800;
      color: #ffffff;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }

    .expanded-content {
      position: absolute;
      inset: 0;
      padding: 28px 22px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      z-index: 3;
      opacity: 0;
      pointer-events: none;
      transform: translateY(14px);
      transition: opacity 0.5s var(--smooth-ease) 0.18s, 
                  transform 0.5s var(--smooth-ease) 0.18s;
    }
  }

  /* ========================================================
     ESTILOS COMPARTIDOS
     ======================================================== */
  .item-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.1s var(--smooth-ease);
  }

  .accordion-item:hover .item-bg {
    transform: scale(1.04);
  }

  .item-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.15) 0%,
      rgba(15, 23, 42, 0.45) 40%,
      rgba(15, 23, 42, 0.94) 100%
    );
    transition: opacity 0.6s ease;
    z-index: 1;
  }

  .accordion-item:not(.active) .item-overlay {
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.4) 0%,
      rgba(15, 23, 42, 0.72) 100%
    );
  }

  .collapsed-num {
    font-size: 0.82rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.08em;
  }

  .collapsed-indicator {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .accordion-item:hover .collapsed-indicator {
    background: var(--accent-blue);
    transform: scale(1.3);
  }

  .expanded-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    width: fit-content;
  }

  .expanded-title {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 12px;
    max-width: 620px;
    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.45);
  }

  .expanded-desc {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    max-width: 560px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
  }

  /* ESTADOS ACTIVO / INACTIVO */
  .accordion-item .collapsed-content {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease 0.18s, visibility 0.35s ease 0.18s;
  }

  .accordion-item.active .collapsed-content {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .accordion-item:not(.active) .expanded-content {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .accordion-item.active .expanded-content {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.65s var(--smooth-ease) 0.22s, 
                visibility 0.65s var(--smooth-ease) 0.22s,
                transform 0.65s var(--smooth-ease) 0.22s;
  }
</style>

<script>
  function setupResearchAccordion() {
    const accordion = document.getElementById('research-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('.accordion-item');

    function activate(selectedItem: HTMLElement) {
      items.forEach((item) => {
        const isActive = item === selectedItem;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });
    }

    items.forEach((item) => {
      item.addEventListener('click', () => activate(item));
      item.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate(item);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupResearchAccordion);
  } else {
    setupResearchAccordion();
  }
  document.addEventListener('astro:page-load', setupResearchAccordion);
</script>

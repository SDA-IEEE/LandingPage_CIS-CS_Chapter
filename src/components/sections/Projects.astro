---
import { getCollection, render } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = allProjects.find((p) => p.data.featured) ?? allProjects[0];
const otherProjects = allProjects.filter((p) => p.id !== featured?.id);
const { Content: FeaturedContent } = featured ? await render(featured) : { Content: null };
---
<section class="section section-surface" id="projects">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Proyectos</div>
      <h2 class="section-title">De la idea al software</h2>
      <p class="section-desc">
        Evidencia tangible de lo que construimos. Cada proyecto es un case
        study: contexto, solución, tecnologías y equipo.
      </p>
    </div>

    {featured ? (
      <div class="projects-showcase">
        <div class="project-featured reveal">
          <div class="project-featured-content project-head">
            <div class="project-number">PROYECTO 01</div>
            <h3 class="project-title">{featured.data.title}</h3>
          </div>
          <div class="project-featured-media">
            <img
              src={featured.data.image}
              alt={`Imagen representativa del proyecto ${featured.data.title}`}
              loading="lazy"
            />
            <div class="project-featured-badge">Proyecto Destacado</div>
          </div>
          <div class="project-featured-content project-body">
            <p class="project-desc">{featured.data.tagline}</p>
            {FeaturedContent && (
              <div class="project-desc">
                <FeaturedContent />
              </div>
            )}
            <div class="project-techs">
              {featured.data.technologies.map((tech) => (
                <span class="project-tech">{tech}</span>
              ))}
            </div>
            <div class="project-links">
              {featured.data.repoUrl && (
                <a href={featured.data.repoUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                  Ver repositorio
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              )}
              {featured.data.demoUrl && (
                <a href={featured.data.demoUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                  Ver demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>

        {otherProjects.length > 0 && (
          <div class="project-grid">
            {otherProjects.map((project) => (
              <div class="project-card reveal">
                <div class="project-card-media">
                  <img
                    src={project.data.image}
                    alt={`Imagen representativa del proyecto ${project.data.title}`}
                    loading="lazy"
                  />
                </div>
                <div class="project-card-body">
                  <h4 class="project-card-title">{project.data.title}</h4>
                  <p class="project-card-desc">{project.data.tagline}</p>
                  <div class="project-card-meta">
                    <span class="project-card-tech">{project.data.technologies.join(' · ')}</span>
                    {project.data.repoUrl && (
                      <a href={project.data.repoUrl} class="project-card-arrow" target="_blank" rel="noopener noreferrer" aria-label={`Ver repositorio de ${project.data.title}`}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        <p class="project-desc reveal" style="text-align:center; margin-top: 32px; opacity: 0.75;">
          Más proyectos del capítulo próximamente. <a href="#join">Únete</a> para conocerlos primero.
        </p>
      </div>
    ) : (
      <p class="project-desc reveal">Proyectos del capítulo próximamente.</p>
    )}
  </div>
</section>

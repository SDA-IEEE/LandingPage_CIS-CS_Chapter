---
---
<section class="hero" id="hero">
  <div class="hero-bg">
    <img
      src="/images/hero-community.jpg"
      alt="Estudiantes colaborando en un espacio de trabajo tecnológico"
      loading="eager"
    />
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-grid"></div>
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title reveal reveal-delay-1">
        <span class="line-1">
          <span class="ieee-accent" >IEEE</span> Computer Society
        </span>
        <span class="line-1" style="font-size: clamp(1.8rem, 4.5vw, 3.5rem)">
          <span style="color: var(--cs-orange)"> × </span>Computational Intelligence Society
        </span>
      </h1>
      <p class="hero-university">Universidad Tecnológica de Bolívar</p>
      <div class="hero-divider reveal reveal-delay-2"></div>
      <p class="hero-subtitle reveal reveal-delay-2">
        No solo aprendemos tecnología. La construimos. Un capítulo donde
        Computer Science y Computational Intelligence convergen para crear,
        investigar y desarrollar soluciones reales.
      </p>
      <div class="hero-convergence reveal reveal-delay-3">
        <div class="hero-convergence-item">
          <span class="hero-convergence-label">Computer Science</span>
          <div class="hero-convergence-tags">
            <span class="hero-tag">Software</span>
            <span class="hero-tag">Algorithms</span>
            <span class="hero-tag">Systems</span>
          </div>
        </div>
        <div class="hero-convergence-item">
          <span class="hero-convergence-label">Computational Intelligence</span>
          <div class="hero-convergence-tags">
            <span class="hero-tag">AI</span>
            <span class="hero-tag">ML</span>
            <span class="hero-tag">Data</span>
          </div>
        </div>
      </div>
      <div class="hero-cta-group reveal reveal-delay-4">
        <a href="#join" class="btn-primary">
          Únete al capítulo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#projects" class="btn-secondary">Ver proyectos</a>
      </div>
    </div>
  </div>
  <div class="hero-showcase" id="heroShowcase">
    <div class="hero-orb orb-left"></div>
    <div class="hero-orb orb-right"></div>
    <article class="hero-showcase-card back" data-hero-card="back">
      <img src="/images/about-research.jpg" alt="Equipo trabajando en investigación" />
      <div class="hero-card-overlay">
        <span class="hero-card-kicker">Investigación aplicada</span>
        <h3>IA para resolver desafíos reales</h3>
      </div>
    </article>
    <article class="hero-showcase-card front" data-hero-card="front">
      <img src="/images/hero-community.jpg" alt="Estudiantes colaborando en proyecto tecnológico" />
      <div class="hero-card-overlay">
        <span class="hero-card-kicker">Próxima generación</span>
        <h3>Tecnología con propósito</h3>
      </div>
    </article>
    <div class="hero-showcase-dots" id="heroShowcaseDots" aria-label="Estado del carrusel visual">
      <span class="hero-dot is-active"></span>
      <span class="hero-dot"></span>
      <span class="hero-dot"></span>
    </div>
  </div>
</section>

---
---

<section class="scroll-phrase-section" id="phrase-section" aria-label="Frase motivacional del capítulo">
  <div class="scroll-phrase-pin">
    <div class="scroll-phrase-track" id="phrase-track">
      <h2 class="scroll-phrase-text" id="target-phrase">
        <span class="phrase-line">¿Listo para</span>
        <span class="phrase-line">construir</span>
        <span class="phrase-line highlight">el futuro</span>
        <span class="phrase-line">con</span>
        <span class="phrase-line">nosotros?</span>
      </h2>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     ESTILOS BASE: TEMA CLARO ADAPTADO & EDITORIAL
     ========================================================= */
  .scroll-phrase-section {
    position: relative;
    width: 100%;
    background: #f8fafc;
    background: radial-gradient(ellipse at 50% 50%, #ffffff 0%, #f1f5f9 60%, #e2e8f0 100%);
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .scroll-phrase-pin {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  /* Halo lumínico sutil para dar profundidad en tema claro */
  .scroll-phrase-pin::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(0, 163, 224, 0.12) 0%,
      rgba(0, 98, 155, 0.04) 45%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Micro-textura de cuadrícula técnica */
  .scroll-phrase-pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.7;
    pointer-events: none;
    z-index: 1;
  }

  .scroll-phrase-text {
    font-family: 'Plus Jakarta Sans', var(--font-display, 'Montserrat', sans-serif);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #0f172a;
    margin: 0;
    position: relative;
    z-index: 2;
  }

  :global(.scroll-phrase-section .char) {
    display: inline-block;
    will-change: transform, opacity;
    transform-origin: center bottom;
    color: #0f172a;
  }

  :global(.scroll-phrase-section .space) {
    display: inline-block;
    width: 0.3em;
  }

  :global(.scroll-phrase-section .word) {
    display: inline-block;
    white-space: nowrap;
  }

  /* Acento de color CIS Cyan adaptado con contraste y brillo elegante */
  .highlight,
  :global(.scroll-phrase-section .highlight),
  :global(.scroll-phrase-section .phrase-line.highlight .char) {
    color: #0084d1 !important;
    text-shadow: 0 4px 28px rgba(0, 163, 224, 0.35), 0 0 50px rgba(0, 132, 209, 0.2);
  }

  /* =========================================================
     DESKTOP (> 768px): TIRA HORIZONTAL CONTINUA
     ========================================================= */
  @media (min-width: 769px) {
    .scroll-phrase-track {
      display: flex;
      align-items: baseline;
      white-space: nowrap;
      user-select: none;
      will-change: transform;
      flex-shrink: 0;
      padding-right: 20vw;
    }
    .scroll-phrase-text {
      font-size: clamp(4rem, 9.5vw, 10.5rem);
      display: inline-flex;
      align-items: baseline;
      flex-shrink: 0;
    }
    .phrase-line {
      display: inline-flex;
      align-items: baseline;
      flex-shrink: 0;
    }
    .phrase-line:not(:last-child)::after {
      content: '\00a0';
    }
  }

  /* =========================================================
     MÓVIL (<= 768px): BLOQUE EDITORIAL COHESIVO
     ========================================================= */
  @media (max-width: 768px) {
    .scroll-phrase-pin {
      justify-content: center;
      padding: 40px 20px;
    }
    .scroll-phrase-track {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .scroll-phrase-text {
      height: auto;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(12px, 2.4vh, 22px);
      align-items: center;
      text-align: center;
    }
    .phrase-line {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      white-space: nowrap;
      font-size: clamp(2rem, 9vw, 3.4rem);
      line-height: 1;
      text-transform: uppercase;
    }
  }

  /* Accesibilidad: movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .scroll-phrase-pin {
      height: auto !important;
      padding: 80px 24px !important;
    }
    .scroll-phrase-track {
      white-space: normal !important;
      transform: none !important;
    }
    :global(.scroll-phrase-section .char) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function setupLinesAndCharacters(container: HTMLElement) {
    const lines = Array.from(container.querySelectorAll<HTMLElement>(".phrase-line"));

    lines.forEach((line) => {
      // Evitar re-ejecución si ya tiene caracteres divididos
      if (line.querySelector(".char")) return;

      const text = line.textContent?.trim() || "";
      line.innerHTML = "";
      const words = text.split(/\s+/);

      words.forEach((wordText, wIdx) => {
        if (!wordText) return;
        const wordSpan = document.createElement("span");
        wordSpan.className = "word";

        wordText.split("").forEach((letter) => {
          const charSpan = document.createElement("span");
          charSpan.className = "char";
          charSpan.textContent = letter;
          wordSpan.appendChild(charSpan);
        });

        line.appendChild(wordSpan);

        if (wIdx < words.length - 1) {
          const spaceSpan = document.createElement("span");
          spaceSpan.className = "space";
          spaceSpan.innerHTML = "&nbsp;";
          line.appendChild(spaceSpan);
        }
      });
    });
  }

  function initResponsiveAnimation() {
    const phrase = document.getElementById("target-phrase");
    const track = document.getElementById("phrase-track");
    const section = document.getElementById("phrase-section");

    if (!phrase || !track || !section) return;

    setupLinesAndCharacters(phrase);

    const chars = Array.from(track.querySelectorAll<HTMLElement>(".char"));
    const lines = Array.from(track.querySelectorAll<HTMLElement>(".phrase-line"));

    const mm = gsap.matchMedia();

    // ========================================================
    // 1. ESCRITORIO (> 768px): TIRA HORIZONTAL DINÁMICA
    // ========================================================
    mm.add("(min-width: 769px)", () => {
      const getStartX = () => window.innerWidth * 0.08;
      const getEndX = () => -(track.scrollWidth - window.innerWidth + 180);
      const getDropPointX = () => window.innerWidth * 0.75;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=2600",
          pin: true,
          scrub: 0.7,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      tl.fromTo(
        track,
        { x: () => getStartX() },
        { x: () => getEndX(), ease: "none", duration: 1 },
        0
      );

      const trackInitialLeft = track.getBoundingClientRect().left;

      chars.forEach((char, index) => {
        const charLeft = char.getBoundingClientRect().left;
        const charOffset = charLeft - trackInitialLeft;

        const totalTravel = getStartX() - getEndX();
        let dropTime = (getStartX() + charOffset - getDropPointX()) / totalTravel;
        dropTime = Math.max(0, Math.min(dropTime, 0.88));

        gsap.set(char, {
          y: -180,
          opacity: 0,
          rotate: index % 2 === 0 ? -12 : 10,
        });

        tl.to(
          char,
          { y: 0, opacity: 1, rotate: 0, ease: "back.out(2)", duration: 0.07 },
          dropTime
        );
      });

      // Margen de pausa de lectura antes de desanclar
      tl.to({}, { duration: 0.15 });
    });

    // ========================================================
    // 2. MÓVIL (<= 768px): CAÍDA COMPACTA, FLUIDA Y PAUSA DE LECTURA
    // ========================================================
    mm.add("(max-width: 768px)", () => {
      gsap.set(track, { x: 0 });

      const mobileTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=1200",
          pin: true,
          scrub: 0.5,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      lines.forEach((line, idx) => {
        const lineChars = line.querySelectorAll<HTMLElement>(".char");

        // Salto de caída elegante y controlado
        gsap.set(lineChars, {
          y: -40,
          opacity: 0,
          rotate: (i) => (i % 2 === 0 ? -5 : 5),
        });

        mobileTl.to(
          lineChars,
          {
            y: 0,
            opacity: 1,
            rotate: 0,
            stagger: 0.018,
            ease: "back.out(1.6)",
            duration: 0.22,
          },
          idx * 0.11
        );
      });

      // Pausa de lectura generosa para que el bloque completo se aprecie antes del scroll a Join Us
      mobileTl.to({}, { duration: 0.4 });
    });

    ScrollTrigger.refresh();
  }

  // Inicialización asegurando carga previa de tipografías
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(initResponsiveAnimation);
  } else {
    window.addEventListener("DOMContentLoaded", initResponsiveAnimation);
  }

  // Soporte para Astro View Transitions
  document.addEventListener("astro:page-load", initResponsiveAnimation);
</script>

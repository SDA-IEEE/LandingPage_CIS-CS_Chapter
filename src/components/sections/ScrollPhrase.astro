---
---

<section class="scroll-phrase-section" id="phrase-section" aria-label="Frase motivacional del capítulo">
  <div class="scroll-phrase-pin">
    <div class="scroll-phrase-track" id="phrase-track">
      <h2 class="scroll-phrase-text" id="target-phrase">
        <span class="phrase-line">¿Listo para</span>
        <span class="phrase-line">construir</span>
        <span class="phrase-line highlight">el futuro</span>
        <span class="phrase-line">con</span>
        <span class="phrase-line">nosotros?</span>
      </h2>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     ESTILOS BASE: TEMA CLARO ADAPTADO & EDITORIAL
     ========================================================= */
  .scroll-phrase-section {
    position: relative;
    width: 100%;
    background: #f8fafc;
    background: radial-gradient(ellipse at 50% 50%, #ffffff 0%, #f1f5f9 60%, #e2e8f0 100%);
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .scroll-phrase-pin {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  /* Halo lumínico sutil para dar profundidad en tema claro */
  .scroll-phrase-pin::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(0, 163, 224, 0.12) 0%,
      rgba(0, 98, 155, 0.04) 45%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Micro-textura de cuadrícula técnica */
  .scroll-phrase-pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.7;
    pointer-events: none;
    z-index: 1;
  }

  .scroll-phrase-text {
    font-family: 'Plus Jakarta Sans', var(--font-display, 'Montserrat', sans-serif);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #0f172a;
    margin: 0;
    position: relative;
    z-index: 2;
  }

  :global(.scroll-phrase-section .char) {
    display: inline-block;
    will-change: transform, opacity;
    transform-origin: center bottom;
    color: #0f172a;
  }

  :global(.scroll-phrase-section .space) {
    display: inline-block;
    width: 0.3em;
  }

  :global(.scroll-phrase-section .word) {
    display: inline-block;
    white-space: nowrap;
  }

  /* Acento de color CIS Cyan adaptado con contraste y brillo elegante */
  .highlight,
  :global(.scroll-phrase-section .highlight),
  :global(.scroll-phrase-section .phrase-line.highlight .char) {
    color: #0084d1 !important;
    text-shadow: 0 4px 28px rgba(0, 163, 224, 0.35), 0 0 50px rgba(0, 132, 209, 0.2);
  }

  /* =========================================================
     DESKTOP (> 768px): TIRA HORIZONTAL CONTINUA
     ========================================================= */
  @media (min-width: 769px) {
    .scroll-phrase-track {
      display: flex;
      align-items: baseline;
      white-space: nowrap;
      user-select: none;
      will-change: transform;
      flex-shrink: 0;
      padding-right: 20vw;
    }
    .scroll-phrase-text {
      font-size: clamp(4rem, 9.5vw, 10.5rem);
      display: inline-flex;
      align-items: baseline;
      flex-shrink: 0;
    }
    .phrase-line {
      display: inline-flex;
      align-items: baseline;
      flex-shrink: 0;
    }
    .phrase-line:not(:last-child)::after {
      content: '\00a0';
    }
  }

  /* =========================================================
     MÓVIL (<= 768px): BLOQUE EDITORIAL COHESIVO
     ========================================================= */
  @media (max-width: 768px) {
    .scroll-phrase-pin {
      justify-content: center;
      padding: 40px 20px;
    }
    .scroll-phrase-track {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .scroll-phrase-text {
      height: auto;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(12px, 2.4vh, 22px);
      align-items: center;
      text-align: center;
    }
    .phrase-line {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      white-space: nowrap;
      font-size: clamp(2rem, 9vw, 3.4rem);
      line-height: 1;
      text-transform: uppercase;
    }
  }

  /* Accesibilidad: movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .scroll-phrase-pin {
      height: auto !important;
      padding: 80px 24px !important;
    }
    .scroll-phrase-track {
      white-space: normal !important;
      transform: none !important;
    }
    :global(.scroll-phrase-section .char) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  function setupLinesAndCharacters(container: HTMLElement) {
    const lines = Array.from(container.querySelectorAll<HTMLElement>(".phrase-line"));
    lines.forEach((line) => {
      if (line.querySelector(".char")) return;
      const text = line.textContent?.trim() || "";
      line.innerHTML = "";
      const words = text.split(/\s+/);
      words.forEach((wordText, wIdx) => {
        if (!wordText) return;
        const wordSpan = document.createElement("span");
        wordSpan.className = "word";
        wordText.split("").forEach((letter) => {
          const charSpan = document.createElement("span");
          charSpan.className = "char";
          charSpan.textContent = letter;
          wordSpan.appendChild(charSpan);
        });
        line.appendChild(wordSpan);
        if (wIdx < words.length - 1) {
          const spaceSpan = document.createElement("span");
          spaceSpan.className = "space";
          spaceSpan.innerHTML = "&nbsp;";
          line.appendChild(spaceSpan);
        }
      });
    });
  }

  function initResponsiveAnimation() {
    const phrase = document.getElementById("target-phrase");
    const track = document.getElementById("phrase-track");
    const section = document.getElementById("phrase-section");
    if (!phrase || !track || !section) return;

    setupLinesAndCharacters(phrase);

    const lines = Array.from(track.querySelectorAll<HTMLElement>(".phrase-line"));
    const totalSteps = lines.length;

    const mm = gsap.matchMedia();
    let cleanupFns: Array<() => void> = [];

    // ========================================================
    // CONTROLADOR GENÉRICO DE PASOS (reemplaza el scrub continuo)
    // ========================================================
    function createStepController(opts: {
      pinDistancePerStep: number;
      onStepEnter: (index: number, tl: gsap.core.Timeline) => void;
    }) {
      let currentStep = 0;
      let isAnimating = false;
      let sectionStartY = 0;

      const st = ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: () => "+=" + opts.pinDistancePerStep * totalSteps,
        pin: true,
        anticipatePin: 1,
        onEnter: () => { sectionStartY = st.start; },
        onEnterBack: () => { sectionStartY = st.start; },
      });

      function goTo(nextStep: number, direction: 1 | -1) {
        if (isAnimating || nextStep < 0 || nextStep > totalSteps - 1) return;
        isAnimating = true;

        const tl = gsap.timeline({
          onComplete: () => {
            currentStep = nextStep;
            isAnimating = false;
          },
        });

        opts.onStepEnter(nextStep, tl);

        gsap.to(window, {
          scrollTo: { y: sectionStartY + opts.pinDistancePerStep * nextStep },
          duration: 0.7,
          ease: "power2.inOut",
        });
      }

      function handleWheel(e: WheelEvent) {
        if (!st.isActive) return;
        const goingDown = e.deltaY > 0;
        if (goingDown && currentStep === totalSteps - 1) return; // libera scroll normal
        if (!goingDown && currentStep === 0) return;
        e.preventDefault();
        if (isAnimating) return;
        goTo(currentStep + (goingDown ? 1 : -1), goingDown ? 1 : -1);
      }

      let touchStartY = 0;
      function handleTouchStart(e: TouchEvent) { touchStartY = e.touches[0].clientY; }
      function handleTouchMove(e: TouchEvent) {
        if (!st.isActive) return;
        const deltaY = touchStartY - e.touches[0].clientY;
        const goingDown = deltaY > 0;
        if (goingDown && currentStep === totalSteps - 1) return;
        if (!goingDown && currentStep === 0) return;
        e.preventDefault();
        if (isAnimating || Math.abs(deltaY) < 30) return;
        touchStartY = e.touches[0].clientY;
        goTo(currentStep + (goingDown ? 1 : -1), goingDown ? 1 : -1);
      }

      window.addEventListener("wheel", handleWheel, { passive: false });
      window.addEventListener("touchstart", handleTouchStart, { passive: true });
      window.addEventListener("touchmove", handleTouchMove, { passive: false });

      return () => {
        window.removeEventListener("wheel", handleWheel);
        window.removeEventListener("touchstart", handleTouchStart);
        window.removeEventListener("touchmove", handleTouchMove);
        st.kill();
      };
    }

    // ========================================================
    // 1. ESCRITORIO (> 768px): PASO = UNA LÍNEA ENTRA + TRACK SE DESPLAZA
    // ========================================================
    mm.add("(min-width: 769px)", () => {
      gsap.set(track, { x: () => window.innerWidth * 0.08 });

      lines.forEach((line) => {
        gsap.set(line.querySelectorAll(".char"), {
          y: -180,
          opacity: 0,
        });
      });

      // Posición x del track necesaria para que cada línea quede centrada al entrar
      const getStepX = (index: number) => {
        const line = lines[index];
        const lineLeft = line.offsetLeft;
        return window.innerWidth * 0.08 - lineLeft * (index / Math.max(totalSteps - 1, 1));
      };

      const cleanup = createStepController({
        pinDistancePerStep: 900,
        onStepEnter: (index, tl) => {
          const line = lines[index];
          const chars = line.querySelectorAll<HTMLElement>(".char");

          tl.to(track, {
            x: getStepX(index),
            duration: 0.6,
            ease: "power2.inOut",
          }, 0)
            .to(chars, {
              y: 0,
              opacity: 1,
              rotate: 0,
              stagger: 0.02,
              ease: "back.out(2)",
              duration: 0.35,
            }, 0.15);
        },
      });

      cleanupFns.push(cleanup);
    });

    // ========================================================
    // 2. MÓVIL (<= 768px): PASO = UNA LÍNEA CAE COMPLETA
    // ========================================================
    mm.add("(max-width: 768px)", () => {
      lines.forEach((line) => {
        gsap.set(line.querySelectorAll(".char"), {
          y: -40,
          opacity: 0,
          rotate: (i: number) => (i % 2 === 0 ? -5 : 5),
        });
      });

      const cleanup = createStepController({
        pinDistancePerStep: window.innerHeight * 0.6,
        onStepEnter: (index, tl) => {
          const chars = lines[index].querySelectorAll<HTMLElement>(".char");
          tl.to(chars, {
            y: 0,
            opacity: 1,
            rotate: 0,
            stagger: 0.02,
            ease: "back.out(1.6)",
            duration: 0.3,
          });
        },
      });

      cleanupFns.push(cleanup);
    });

    ScrollTrigger.refresh();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cleanupFns.forEach((fn) => fn());
        cleanupFns = [];
      },
      { once: true }
    );
  }

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(initResponsiveAnimation);
  } else {
    window.addEventListener("DOMContentLoaded", initResponsiveAnimation);
  }

  document.addEventListener("astro:page-load", initResponsiveAnimation);
</script>
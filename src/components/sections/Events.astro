---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/site';

const events = (await getCollection('events')).sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);

const monthFormatter = new Intl.DateTimeFormat('es-CO', { month: 'long', year: 'numeric' });
const formatMonth = (isoDate: string) => monthFormatter.format(new Date(`${isoDate}T00:00:00`));
---
<section class="section" id="events">
  <div class="container">
    <div class="section-heading reveal">
      <div class="section-label">Eventos</div>
      <h2 class="section-title">Una comunidad en movimiento</h2>
      <p class="section-desc">
        Talleres, hackathons, charlas y encuentros donde el conocimiento se
        comparte y la comunidad se fortalece.
      </p>
    </div>

    {events.length > 0 ? (
      <div class="events-timeline">
        <div class="timeline-line">
          <div class="timeline-progress" id="timelineProgress"></div>
        </div>
        {events.map((event) => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-card">
              <div class="timeline-date">{formatMonth(event.data.date)}</div>
              <h3 class="timeline-title">{event.data.title}</h3>
              <div class="timeline-meta">
                <span class="timeline-tag">{event.data.type}</span>
                {event.data.location && <span>{event.data.location}</span>}
                <span>{event.data.modality}</span>
              </div>
              {event.data.image && (
                <img
                  src={event.data.image}
                  alt={`Imagen del evento ${event.data.title}`}
                  class="timeline-image"
                  loading="lazy"
                />
              )}
              {event.data.registrationUrl && (
                <a href={event.data.registrationUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                  Inscribirme
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="reveal" style="text-align:center; padding: 48px 16px;">
        <p class="section-desc" style="max-width: 560px; margin: 0 auto 20px;">
          Aún no tenemos eventos programados públicamente. Síguenos en nuestras
          redes o entra al portal de inscripciones para enterarte apenas se
          confirme el próximo.
        </p>
        <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Síguenos para enterarte
        </a>
      </div>
    )}
  </div>
</section>

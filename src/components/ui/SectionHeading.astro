---
interface Props {
  badge?: string;
  badgeVariant?: 'ieee' | 'cs' | 'cis' | 'neutral';
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
  class?: string;
}

const {
  badge,
  badgeVariant = 'ieee',
  title,
  subtitle,
  align = 'left',
  theme = 'light',
  class: className = ''
} = Astro.props;

import Badge from './Badge.astro';
---

<div class={`space-y-4 ${align === 'center' ? 'text-center mx-auto max-w-3xl' : 'max-w-3xl'} ${className}`}>
  {badge && (
    <div>
      <Badge variant={badgeVariant} size="sm">
        {badge}
      </Badge>
    </div>
  )}
  
  <h2 class={`text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight font-heading leading-[1.15] ${
    theme === 'dark' ? 'text-white' : 'text-slate-900'
  }`}>
    {title}
  </h2>
  
  {subtitle && (
    <p class={`text-base sm:text-lg font-body leading-relaxed max-w-2xl ${
      theme === 'dark' ? 'text-slate-300' : 'text-slate-600'
    } ${align === 'center' ? 'mx-auto' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
